# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Публичный HTTPS URL Mini App (для кнопки в боте)
# Локально: используйте ngrok / cloudflared
WEBAPP_URL=https://your-domain.example

# Порт сервера (бот + API + статика)
PORT=3000

# Telegram user id админов через запятую (видеть всех пользователей и суммы)
# Узнать свой id: @userinfobot или откройте Mini App и посмотрите /api/me
ADMIN_IDS=123456789

# Локально без Telegram: ALLOW_DEV_AUTH=1 (dev-user станет админом, если ADMIN_IDS пуст)
# ALLOW_DEV_AUTH=1
