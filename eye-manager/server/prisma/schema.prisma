generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id
  login         String   @unique
  name          String   @default("")
  salt          String   @default("")
  hash          String   @default("")
  createdAt     BigInt
  role          String   @default("user")
  isBot         Boolean  @default(false)
  level         Int      @default(1)
  xp            Int      @default(0)
  cupsPlayed    Int      @default(0)
  cupsWon       Int      @default(0)
  teamBound     Boolean  @default(false)
  teamCreatedAt BigInt?
  clubName      String?
  regIp         String?
  strength      Int?
  money         Int      @default(500000)
  fans          Int      @default(12000)
  boosters      Int      @default(3)
  fame          Int      @default(0)
  prestige      Int      @default(0)
  points        Int      @default(0)
  lastWageAt    BigInt?
  cupEventsJson String   @default("[]")
  sessions      Session[]
  club          Club?
}

model Session {
  token     String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt BigInt
  lastAt    BigInt

  @@index([userId])
}

model Club {
  userId    String @id
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  short     String @default("EYE")
  color     String @default("#1FA65A")
  updatedAt BigInt
  dataJson  String
}

model MatchRec {
  id        String @id
  status    String @default("done")
  homeId    String
  awayId    String
  createdAt BigInt
  dataJson  String

  @@index([homeId])
  @@index([awayId])
  @@index([status])
}

model Cup {
  id        String  @id
  status    String  @default("open")
  bracketId String?
  archived  Boolean @default(false)
  updatedAt BigInt
  dataJson  String
}

model Meta {
  key       String @id
  valueJson String
}
